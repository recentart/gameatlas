{
  // The ad frame lives on its own origin so ad-network code can never reach
  // GameAtlas pages. Deploy: npx wrangler deploy -c ad-frame/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gameatlas-ads",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
